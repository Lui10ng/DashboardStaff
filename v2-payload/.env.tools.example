# =====================================
# Payload CMS Core Configuration
# =====================================

# PAYLOAD_SECRET: **REQUIRED**. A long, random string used for securely signing authentication tokens (JWTs) and encrypting data.
# Generate a strong secret (e.g., using `openssl rand -base64 32`) and keep it private.
# Used directly by the Payload application.
PAYLOAD_SECRET=

# =====================================
# PostgreSQL Database Configuration
# =====================================
# These variables are used by the `postgres` service in docker-compose.yml to initialize the database
# AND by the `payload` service (via DATABASE_URI construction in docker-compose.yml) to connect to it.

# POSTGRES_USER: The username for the PostgreSQL database. Default in docker-compose.yml is 'postgres' if not set.
POSTGRES_USER=          # Example custom user
``
# POSTGRES_PASSWORD: The password for the specified PostgreSQL user. **REQUIRED**. Set a strong password. Default in docker-compose.yml is 'password' if not set (INSECURE default!).
POSTGRES_PASSWORD= # Replace with a strong password

# POSTGRES_DB: The name of the database to use within PostgreSQL. Default in docker-compose.yml is 'payload' if not set.
POSTGRES_DB=      # Example custom DB name

# POSTGRES_PORT: (Optional) If you want to expose the PostgreSQL container's port 5432 to a *different* port on your host machine.
# Example: Setting this to 5433 allows connecting from your host using `localhost:5433`.
# Primarily used by the `postgres` service's `ports` mapping in docker-compose.yml.
POSTGRES_PORT=              # Example: Expose Postgres on host port 5433 (optional)

# NOTE: DATABASE_URI is constructed automatically within the docker-compose.yml file for the `payload` service,
# combining the above PG variables (or their defaults) with the Docker service name (`postgres`).
# Example constructed value: postgresql://<user>:<password>@postgres:5432/<db>