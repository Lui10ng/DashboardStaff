# =====================================
# STAGING_DOMAIN: The root domain name for the staging environment (e.g., staging.yourproject.com).
# =====================================
# This variable is used in docker-compose.staging.yml to construct environment-specific URLs
# such as NEXT_PUBLIC_SERVER_URL and NEXT_PUBLIC_SHARE_SERVER_URL for the Payload service.
# It helps ensure that client-side requests and shared links correctly point to the
# staging deployment when running the application in a simulated staging mode.
# Example: if STAGING_DOMAIN=localhost, then NEXT_PUBLIC_SERVER_URL might become http://localhost:3000
# Example: if STAGING_DOMAIN=my-staging-app.dev, then NEXT_PUBLIC_SERVER_URL might become http://my-staging-app.dev:3000
STAGING_DOMAIN=

# =====================================
# Payload CMS Core Configuration
# =====================================

# PAYLOAD_SECRET: **REQUIRED**. A long, random string used for securely signing authentication tokens (JWTs) and encrypting data.
# Generate a strong secret (e.g., using `openssl rand -base64 32`) and keep it private.
# Used directly by the Payload application.
PAYLOAD_SECRET=

# =====================================
# PostgreSQL Database Configuration
# =====================================
# These variables are used by the `postgres` service in docker-compose.yml to initialize the database
# AND by the `payload` service (via DATABASE_URI construction in docker-compose.yml) to connect to it.

# POSTGRES_USER: The username for the PostgreSQL database. Default in docker-compose.yml is 'postgres' if not set.
POSTGRES_USER=          # Example custom user

# POSTGRES_PASSWORD: The password for the specified PostgreSQL user. **REQUIRED**. Set a strong password. Default in docker-compose.yml is 'password' if not set (INSECURE default!).
POSTGRES_PASSWORD= # Replace with a strong password

# POSTGRES_HOST: The hostname for the PostgreSQL database. Default in docker-compose.yml is 'postgres' if not set.
POSTGRES_HOST=

# POSTGRES_DB: The name of the database to use within PostgreSQL. Default in docker-compose.yml is 'payload' if not set.
POSTGRES_DB=      # Example custom DB name

# POSTGRES_PORT: (Optional) If you want to expose the PostgreSQL container's port 5432 to a *different* port on your host machine.
# Example: Setting this to 5433 allows connecting from your host using `localhost:5433`.
# Primarily used by the `postgres` service's `ports` mapping in docker-compose.yml.
POSTGRES_PORT=              # Example: Expose Postgres on host port 5433 (optional)

# NOTE: DATABASE_URI is constructed automatically within the docker-compose.yml file for the `payload` service,
# combining the above PG variables (or their defaults) with the Docker service name (`postgres`).
# Example constructed value: postgresql://<user>:<password>@postgres:5432/<db>

# =====================================
# Redis Cache/Queue Configuration
# =====================================

# REDIS_PORT: (Optional) If you want to expose the Redis container's port 6379 to a *different* port on your host machine.
# Example: Setting this to 6380 allows connecting from your host using `localhost:6380`.
# Primarily used by the `redis` service's `ports` mapping in docker-compose.yml.
REDIS_PORT=                 # Example: Expose Redis on host port 6380 (optional)

# NOTE: REDIS_URL is constructed automatically within the docker-compose.yml file for the `payload` service,
# using the Docker service name (`redis`).
# Example constructed value: redis://redis:6379

# =====================================
# Payload/Next.js Server URL
# =====================================

# NEXT_PUBLIC_SERVER_URL: The *publicly accessible* base URL of your Payload backend.
# This is crucial for client-side code (e.g., in a separate SvelteKit frontend or even within Payload's admin UI)
# to correctly make requests back to the Payload API endpoints.
# In local Docker development, this is typically `http://localhost:3000` (matching the exposed port).
# In production, this would be your deployed application's domain (e.g., `https://myapp.com`).
# The `NEXT_PUBLIC_` prefix makes it available in browser-side JavaScript in Next.js.
NEXT_PUBLIC_SERVER_URL=

# =====================================
# Optional Plugin/Service Configurations
# =====================================

# --- AWS S3 Storage Adapter --- (Only if using @payloadcms/storage-s3)
# AWS_ACCESS_KEY_ID: Your AWS Access Key ID for accessing S3.
AWS_ACCESS_KEY_ID=''

# AWS_SECRET_ACCESS_KEY: Your AWS Secret Access Key for accessing S3.
AWS_SECRET_ACCESS_KEY=''

# Note: You also need to configure AWS_REGION and S3_BUCKET within your Payload config where the adapter is initialized.

# --- Clerk Authentication --- (Only if using Clerk for authentication)
# CLERK_SECRET_KEY: Your Clerk instance's secret key (from Clerk dashboard: API Keys -> Secret Keys).
# Required for backend communication with Clerk.
CLERK_SECRET_KEY=''

# CLERK_WEBHOOK_SIGNING_SECRET: The signing secret for verifying incoming webhooks from Clerk (e.g., user creation/updates).
# Found in Clerk dashboard: Webhooks -> Select Endpoint -> Signing Secret.
CLERK_WEBHOOK_SIGNING_SECRET=''

# --- Ngrok Tunneling --- (Only if using the ngrok service in docker-compose.yml)
# NGROK_AUTHTOKEN: Your Ngrok authentication token (from your Ngrok dashboard: Your Authtoken).
# Required to use features like custom/static domains.
NGROK_AUTHTOKEN=''

# NGROK_STATIC_DOMAIN: (Optional but recommended) Your reserved static domain from Ngrok (e.g., `your-app.ngrok-free.app`).
# Used by the `ngrok` service in docker-compose.yml to create a predictable tunnel URL.
NGROK_STATIC_DOMAIN=''